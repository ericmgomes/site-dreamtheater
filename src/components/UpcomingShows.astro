---
import Icon from './Icon.astro';
import { shows, tourUrl } from '../data/shows';
import { researchedLabel } from '../data/site';
const brazilShows = shows.filter(show => show.countryCode === 'BR');
---
<div class="tour-panel">
  <div class="tour-panel-title"><span class="eyebrow">Na estrada · Brasil</span><h3>O próximo encontro.</h3><a class="text-link" href={tourUrl} target="_blank" rel="noopener noreferrer">Ver agenda oficial <Icon size={18}/></a></div>
  <div class="tour-panel-content">
    {brazilShows.length ? <ul class="upcoming-list">{brazilShows.map(show => <li class="is-brazil"><time datetime={show.date}>{new Intl.DateTimeFormat('pt-BR', { dateStyle: 'medium', timeZone: 'UTC' }).format(new Date(`${show.date}T12:00:00Z`))}</time><div><h4>{show.city}, Brasil</h4><p>{show.venue}</p></div><a href={show.url} target="_blank" rel="noopener noreferrer">Ver show <Icon size={16}/></a></li>)}</ul> : <><h4>De olho na próxima turnê.</h4><p>Na consulta de {researchedLabel}, não havia novas datas futuras confirmadas no Brasil. Acompanhe os próximos anúncios direto com a banda.</p><span class="data-note">Dream Theater · Agenda oficial</span></>}
  </div>
</div>
