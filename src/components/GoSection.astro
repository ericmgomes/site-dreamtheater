---
import SectionHeading from './SectionHeading.astro';
import Icon from './Icon.astro';
import MusicianGroup from './MusicianGroup.astro';
import ProfilePhoto from './ProfilePhoto.astro';
import { coverBands } from '../data/coverBands';
import { guitarists } from '../data/guitarists';
import { bassists, keyboardists } from '../data/coverMusicians';
---
<section class="section go wrap" id="va" aria-labelledby="go-title">
  <SectionHeading id="go-title" number="03" title="Covers" description="O som do Dream Theater nas mãos de brasileiros." />
  <nav class="cover-shortcuts" aria-label="Navegar pelos covers">
    <a href="#covers-bands">Bandas covers</a>
    <a href="#covers-guitar">Guitarristas</a>
    <a href="#covers-bass">Baixistas</a>
    <a href="#covers-keys">Tecladistas</a>
  </nav>
  <div class="subsection-heading"><h3 id="covers-bands">O som é deles. A cena é nossa.</h3><span class="eyebrow">Tributos brasileiros</span></div>
  <div class="cover-grid">
    {coverBands.map((band, index) => (
      <article class="cover-item">
        <span class="cover-index">{String(index + 1).padStart(2, '0')}</span>
        <div class="cover-heading">
          <ProfilePhoto name={band.name} image={band.image} />
          <div class="cover-heading-text"><p class="eyebrow">{band.location || 'Brasil'}</p><h4>{band.name}</h4></div>
        </div>
        <p class="cover-description">{band.description}</p>
        <div class="social-links">
          <a class="instagram-link" href={band.instagram} target="_blank" rel="noopener noreferrer">
            <Icon name="instagram" size={19}/> {band.instagramLabel || 'Instagram'} <Icon size={15}/>
          </a>
          {band.website && <a href={band.website} target="_blank" rel="noopener noreferrer">Site do projeto <Icon size={15}/></a>}
          {band.youtube && <a href={band.youtube} target="_blank" rel="noopener noreferrer">YouTube <Icon size={15}/></a>}
        </div>
      </article>
    ))}
  </div>
  <MusicianGroup id="guitar" title="Guitarra" label="guitarristas brasileiros" musicians={guitarists} />
  <MusicianGroup id="bass" title="Baixo" label="baixistas brasileiros" musicians={bassists} />
  <MusicianGroup id="keys" title="Teclado" label="tecladistas brasileiros" musicians={keyboardists} />
</section>
