---
import Icon from './Icon.astro';
import type { CoverMusician } from '../data/types';
interface Props { id: string; title: string; label: string; musicians: CoverMusician[]; }
const { id, title, label, musicians } = Astro.props;
---
<div class="musician-group" data-instrument={id}>
  <div class="subsection-heading musician-heading"><h3 id={`covers-${id}`}>{title}</h3><span class="eyebrow">{musicians.length} {label}</span></div>
  <div class="musician-grid" aria-labelledby={`covers-${id}`}>
    {musicians.map(musician => <article class="musician-item">
      {musician.image && <img class="musician-photo" src={musician.image} alt={musician.name} width="100" height="100" loading="lazy" decoding="async"/>}
      <div><h4>{musician.name}</h4><p>{musician.description}</p><div class="social-links">
        {musician.instagram && <a class="instagram-link" href={musician.instagram} target="_blank" rel="noopener noreferrer"><Icon name="instagram" size={19}/> Instagram <Icon size={15}/></a>}
        {musician.youtube && <a href={musician.youtube} target="_blank" rel="noopener noreferrer">YouTube <Icon size={15}/></a>}
        {musician.website && <a href={musician.website} target="_blank" rel="noopener noreferrer">Site <Icon size={15}/></a>}
      </div></div>
    </article>)}
  </div>
</div>
