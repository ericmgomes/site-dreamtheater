---
import SectionHeading from './SectionHeading.astro';
import Icon from './Icon.astro';
import { setlists } from '../data/setlists';
import { researchedLabel } from '../data/site';
const formatDate = (date: string) => new Intl.DateTimeFormat('pt-BR', { day: '2-digit', month: 'short', year: 'numeric', timeZone: 'UTC' }).format(new Date(`${date}T12:00:00Z`));
const pageSize = 12;
const firstYear = setlists.at(-1)?.date.slice(0, 4);
const lastYear = setlists[0]?.date.slice(0, 4);
const years = [...new Set(setlists.map(show => show.date.slice(0, 4)))];
const cityCount = (city: string) => setlists.filter(show => show.city === city).length;
const cities = [...new Set(setlists.map(show => show.city))].sort((a, b) => cityCount(b) - cityCount(a) || a.localeCompare(b, 'pt-BR'));
---
<section class="section remember wrap" id="relembre" aria-labelledby="remember-title">
  <SectionHeading id="remember-title" number="01" title="Shows" />
  <div class="section-toolbar"><span class="quiet-label">SHOWS NO BRASIL · SETLIST.FM</span><span class="data-note">{setlists.length} shows · {firstYear}–{lastYear}</span></div>
  <div class="show-city-filter" data-setlist-filter hidden>
    <label for="show-city">Cidade</label>
    <select id="show-city" data-setlist-city aria-controls="setlist-history">
      <option value="">Todas as cidades</option>
      {cities.map(city => <option value={city}>{city} ({cityCount(city)})</option>)}
    </select>
  </div>
  <div class="setlist-browser" data-setlist-browser>
  <aside class="show-timeline" data-show-timeline aria-label="Linha do tempo dos shows no Brasil" hidden>
    <span class="timeline-label">Ano</span>
    <div class="timeline-track">
      <span class="timeline-progress" aria-hidden="true"></span>
      <ol class="timeline-years" role="list">{years.map((year, index) => <li data-timeline-year={year} style={`--year-position: ${index / Math.max(1, years.length - 1) * 100}%`}><a href={`#show-${setlists.findIndex(show => show.date.startsWith(year))}`} aria-label={`Ver shows de ${year}`}>{year}</a></li>)}</ol>
      <span class="timeline-marker" data-timeline-marker aria-hidden="true"></span>
    </div>
    <p class="sr-only" data-timeline-status></p>
  </aside>
  <div class="setlist-scroll" id="setlist-history" role="region" aria-label="Histórico de shows no Brasil" aria-describedby="setlist-status" tabindex="0" data-setlist-scroll data-page-size={pageSize} data-load-margin="32">
    <ul class="setlist-list" role="list">
      {setlists.map((show, index) => <li id={`show-${index}`} class="setlist-card" data-setlist data-city={show.city} data-year={show.date.slice(0, 4)} data-country={show.countryCode}>
        <a href={show.url} target="_blank" rel="noopener noreferrer" class="setlist-card-link" aria-label={`Ver setlist: ${show.city}, ${formatDate(show.date)}, ${show.venue}${show.tour ? `, ${show.tour}` : ''}`}>
          <div class="show-card-top"><time datetime={show.date}>{formatDate(show.date)}</time><span>Setlist <Icon size={14}/></span></div>
          <div class="show-location"><h3>{show.city}{show.region && <span>, {show.region}</span>}</h3><p>{show.venue}</p></div>
          {show.tour && <p class="tour-name">{show.tour}</p>}
        </a>
      </li>)}
    </ul>
    <div class="setlist-load-more" data-setlist-sentinel hidden>
      <button type="button" data-setlist-more aria-controls="setlist-history">Carregar mais shows</button>
    </div>
  </div>
  </div>
  <div class="setlist-summary"><p id="setlist-status" class="data-note" role="status" aria-live="polite" aria-atomic="true" data-setlist-status>{setlists.length} shows no Brasil.</p><span class="data-note" data-setlist-hint>Role a lista para consultar o histórico.</span></div>
  <div class="section-foot"><span class="data-note">Histórico no Brasil · Atualizado em {researchedLabel}</span></div>
</section>
