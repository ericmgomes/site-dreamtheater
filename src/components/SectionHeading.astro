---
interface Props { id: string; number: string; title: string; description?: string; }
const { id, number, title, description } = Astro.props;
---
<div class="section-heading">
  <div class="section-title"><span class="section-number">{number} /</span><h2 id={id}>{title}</h2></div>
  {description && <p>{description}</p>}
</div>
